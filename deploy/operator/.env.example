# deposits-node operator config template.
#
# Copy to `.env` then either:
#   - Run `./init.sh` to fill in interactively (recommended for first
#     install — it also generates the signer's transport keypair and
#     wires SIGNER_PUBKEY back into this file), OR
#   - Edit by hand if you know what you're doing.
#
# Everything below has a default unless marked REQUIRED.

# ============================================================================
# REQUIRED — operator identity + chain
# ============================================================================

# Bitcoin network. One of: bitcoin, testnet, signet, regtest
NETWORK=bitcoin

# Operator name. Shows up in the node's advertisement; pick something
# stable and recognisable. Also used as the docker container prefix.
OPERATOR_NAME=operator

# ============================================================================
# REQUIRED — nostr relays
# ============================================================================

# Durable ledger relay — the source of truth for the protocol. Operators
# publish advertisements + ledger updates here; depositors subscribe.
# Use a relay you trust to stay up; for mainnet the project runs
# wss://relay.bitcoindeposits.net.
RELAY_LEDGERS=wss://relay.bitcoindeposits.net

# Optional messaging relay — used for ephemeral request/response between
# depositor wallets and your daemon. Falls back to RELAY_LEDGERS if unset.
RELAY_MESSAGING=

# ============================================================================
# REQUIRED — signer pubkey (filled in by ./init.sh)
# ============================================================================

# The signer's transport pubkey (33-byte compressed hex). The wizard
# generates the signer's keypair and writes the pubkey here. The daemon
# pins this — if the signer's pubkey changes, the daemon refuses to talk
# to it.
SIGNER_PUBKEY=

# ============================================================================
# Lightning backend
# ============================================================================

# Which Lightning daemon to talk to. One of: ldk, lnd, cln
#   ldk  — bundled LDK Server via ldk-server-cli (works out of the box but
#          requires installing ldk-server separately)
#   lnd  — connect to your existing LND via its REST API + macaroon
#   cln  — connect to your existing CLN via its Unix socket
LIGHTNING_BACKEND=ldk

# --- LDK config (LIGHTNING_BACKEND=ldk) ---
LDK_HOST=
LDK_PORT=
LDK_API_KEY=
LDK_TLS_CERT=

# --- LND config (LIGHTNING_BACKEND=lnd) ---
# REST endpoint of your LND node. Default LND port is 8080; example:
#   LND_REST_URL=https://127.0.0.1:8080
# Auth: use ONE of HEX or FILE. HEX is the macaroon's binary contents
# hex-encoded; FILE is a path to the binary macaroon file (mounted into
# the container via docker-compose.override.yml — see README).
LND_REST_URL=
LND_MACAROON_HEX=
LND_MACAROON_FILE=
LND_TLS_CERT_FILE=

# --- CLN config (LIGHTNING_BACKEND=cln) ---
# Unix socket path to CLN's lightning-rpc. Mount the socket's parent
# directory into the container via docker-compose.override.yml (see README)
# and point this at the in-container path.
CLN_SOCKET_PATH=

# ============================================================================
# Chain backend
# ============================================================================

# Which chain data source. One of: esplora, bitcoind, electrum
#   esplora  — HTTP API (Blockstream public esplora or your own electrs)
#   bitcoind — direct JSON-RPC to your bitcoin full node
#   electrum — electrum protocol over TCP (electrs/fulcrum)
CHAIN_BACKEND=esplora

# --- Esplora config (CHAIN_BACKEND=esplora) ---
# HTTP base URL of the esplora service. Public examples:
#   bitcoin  — https://blockstream.info/api
#   testnet  — https://blockstream.info/testnet/api
ESPLORA_URL=https://blockstream.info/api

# --- Bitcoind RPC config (CHAIN_BACKEND=bitcoind) ---
# bitcoind requires -server=1 and -txindex=1.
# Use either USER+PASS or COOKIE_FILE (cookie is easier; auto-rotates).
BITCOIND_RPC_URL=
BITCOIND_RPC_USER=
BITCOIND_RPC_PASS=
BITCOIND_COOKIE_FILE=

# --- Electrum config (CHAIN_BACKEND=electrum) ---
# Standard electrs port is 50001 (plain TCP). TLS not yet supported.
ELECTRUM_HOST=
ELECTRUM_PORT=

# ============================================================================
# Optional
# ============================================================================

# Rust log filter. Defaults to info. Examples:
#   RUST_LOG=debug,h2=info,hyper=info   (verbose but quiet on transport)
#   RUST_LOG=deposits_node=info
RUST_LOG=info

# Bind address for the metrics endpoint (Prometheus scrapes this).
# Default 127.0.0.1:9100 — accessible only from the host. Change to
# 0.0.0.0:9100 if you scrape from a different host.
METRICS_BIND=127.0.0.1:9100

# Per-deposit balance cap (msats). The lnurl gateway exposes this as
# maxSendable. Leave empty for no cap.
MAX_DEPOSIT_BALANCE_MSATS=

# Image tag to deploy. Override when testing a specific build; default
# uses the locally-built image (build with `bin/build-images.sh` or
# `docker build` from the repo root).
DEPOSITS_IMAGE=deposits-node:latest
