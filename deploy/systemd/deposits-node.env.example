# deposits-node systemd config.
#
# Install location: /etc/deposits/deposits-node.env (mode 0640, owned
# by root:deposits so the daemon can read but only root can edit).
#
# Run ./init.sh to populate the required values interactively (it'll
# also generate the signer's transport keypair, write SIGNER_PUBKEY
# back here, and allowlist the daemon on the signer).

# ============================================================================
# REQUIRED — operator identity + chain
# ============================================================================

# Bitcoin network. One of: bitcoin, testnet, signet, regtest
NETWORK=bitcoin

# Operator name. Shows up in the node's advertisement; pick something
# stable and recognisable.
OPERATOR_NAME=operator

# ============================================================================
# REQUIRED — nostr relays
# ============================================================================

# Durable ledger relay — the source of truth for the protocol.
RELAY_LEDGERS=wss://relay.bitcoindeposits.net

# Optional messaging relay (falls back to RELAY_LEDGERS if unset).
RELAY_MESSAGING=

# ============================================================================
# REQUIRED — signer pubkey (filled in by ./init.sh)
# ============================================================================

# The signer's transport pubkey (33-byte compressed hex). init.sh
# generates the signer's keypair and writes the pubkey here.
SIGNER_PUBKEY=

# ============================================================================
# Lightning backend
# ============================================================================

# Which Lightning daemon to talk to. One of: ldk, lnd, cln
LIGHTNING_BACKEND=lnd

# --- LND config (LIGHTNING_BACKEND=lnd) ---
# REST endpoint of your LND node. Default LND port is 8080.
LND_REST_URL=https://127.0.0.1:8080
# Path to a macaroon with custodial permissions. The 'deposits' user
# must be able to read this file (often via group permissions on the
# LND data dir or by symlinking a copy with the right owner).
LND_MACAROON_FILE=/var/lib/lnd/data/chain/bitcoin/mainnet/admin.macaroon
# Path to LND's TLS cert (typically /var/lib/lnd/tls.cert).
LND_TLS_CERT_FILE=/var/lib/lnd/tls.cert

# --- CLN config (LIGHTNING_BACKEND=cln) ---
# Path to CLN's lightning-rpc socket. Group-readable by 'deposits'.
CLN_SOCKET_PATH=/var/lib/lightningd/bitcoin/lightning-rpc

# --- LDK config (LIGHTNING_BACKEND=ldk) ---
# Only set these if you run ldk-server separately.
LDK_HOST=
LDK_PORT=
LDK_API_KEY=
LDK_TLS_CERT=

# ============================================================================
# Chain backend
# ============================================================================

# Which chain data source. One of: esplora, bitcoind, electrum
CHAIN_BACKEND=bitcoind

# --- Bitcoind RPC config (CHAIN_BACKEND=bitcoind) ---
# bitcoind requires -server=1 and -txindex=1.
# Use either USER+PASS or COOKIE_FILE (cookie auto-rotates).
BITCOIND_RPC_URL=http://127.0.0.1:8332
BITCOIND_RPC_USER=
BITCOIND_RPC_PASS=
BITCOIND_COOKIE_FILE=/var/lib/bitcoind/.cookie

# --- Esplora config (CHAIN_BACKEND=esplora) ---
# Public default works but trusts a third party for chain queries; run
# your own electrs if you can.
ESPLORA_URL=https://blockstream.info/api

# --- Electrum config (CHAIN_BACKEND=electrum) ---
ELECTRUM_HOST=127.0.0.1
ELECTRUM_PORT=50001

# ============================================================================
# Service surface
# ============================================================================

# Rust log filter. Defaults to info.
RUST_LOG=info

# Bind for the operator admin UI (Tier 5). Loopback only by default;
# front with caddy/nginx if you need remote access (never expose 8765
# raw — the token is bearer-only).
ADMIN_BIND=127.0.0.1:8765

# Opt out of autonomous post-expiry self-rescue. With this unset, the
# daemon's auto_quorum_refresh handles the DEP-05 §Lifecycle cascade
# without operator intervention. Set to "1" to require explicit
# `deposits-node quorum repair --yes` invocation instead.
# DEPOSITS_DISABLE_AUTO_SELF_RESCUE=
