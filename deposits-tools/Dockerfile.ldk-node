# LDK Node Dockerfile for deposits-rust
FROM rust:latest as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    curl \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy ldk-node (includes vendor/rust-lightning)
COPY ldk-node/ ldk-node/

# Copy deposits-rust workspace
COPY deposits-rust/Cargo.toml deposits-rust/Cargo.lock ./deposits-rust/
COPY deposits-rust/deposits-core/ deposits-rust/deposits-core/
COPY deposits-rust/deposits-ldk/ deposits-rust/deposits-ldk/
COPY deposits-rust/deposits-tools/ deposits-rust/deposits-tools/

# Build the LDK server for deposits
# Clean to ensure Lightning fork changes are compiled
# Features: bitcoin-deposits-non-conforming includes bitcoin-deposits and enables testing APIs
WORKDIR /app/deposits-rust
RUN cargo clean && cargo build --release --features bitcoin-deposits-non-conforming --bin ldk-server-deposits

# Runtime stage - use same base as builder to avoid GLIBC issues
FROM rust:latest

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create ldk user
RUN useradd -m -s /bin/bash ldk

# Copy binary from builder
COPY --from=builder /app/deposits-rust/target/release/ldk-server-deposits /usr/local/bin/ldk-server

# Create data directory with proper permissions
RUN mkdir -p /ldk && chown -R ldk:ldk /ldk && chmod -R 755 /ldk

# Switch to ldk user
USER ldk
WORKDIR /ldk

# Expose Lightning P2P port and API port
EXPOSE 9735 3000

# Default command - start the LDK server
CMD ["ldk-server"]
