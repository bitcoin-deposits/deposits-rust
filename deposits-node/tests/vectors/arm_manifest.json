{
  "description": "DEP-06 §Arm manifests (strict-lottery-v8): whether a published manifest (a list of {armer, seq}) is a valid arm set for round `round`'s window (opens, closes]; round 1's window is (-1, c], c the confiscation's block. Valid iff every entry names an arm in `arms`, no armer is named twice, each named arm is among its armer's first 4 arms by sequence (every round counts), is of `round`, and its signed block_height h satisfies opens < h <= closes. Omitting an armer is never a fault. `valid` is the verdict; when valid the judge rebuilds the spend from exactly the named arms (their eligibility cut and lottery), never from each armer's latest arm. Shared by cl-deposits (inspect/lottery-test.lisp, manifest-arms) and deposits-rust (deposits-node armers.rs, manifest_arms).",
  "cases": [
    {"name": "round 1: a backdated re-arm after the confiscation; the manifest names the arm it was built from",
     "round": 1, "opens": -1, "closes": 200,
     "arms": [{"armer": "A", "seq": 5, "height": 190, "round": 1},
              {"armer": "B", "seq": 7, "height": 192, "round": 1},
              {"armer": "B", "seq": 9, "height": 200, "round": 1}],
     "manifest": [{"armer": "A", "seq": 5}, {"armer": "B", "seq": 7}],
     "valid": true},
    {"name": "round 1: a newcomer's backdated first arm after the confiscation is simply not named",
     "round": 1, "opens": -1, "closes": 200,
     "arms": [{"armer": "A", "seq": 5, "height": 190, "round": 1},
              {"armer": "N", "seq": 3, "height": 199, "round": 1}],
     "manifest": [{"armer": "A", "seq": 5}],
     "valid": true},
    {"name": "round 1: nine armers, the manifest names two",
     "round": 1, "opens": -1, "closes": 200,
     "arms": [{"armer": "A", "seq": 5, "height": 190, "round": 1}, {"armer": "B", "seq": 5, "height": 190, "round": 1},
              {"armer": "C", "seq": 5, "height": 199, "round": 1}, {"armer": "D", "seq": 5, "height": 199, "round": 1},
              {"armer": "E", "seq": 5, "height": 199, "round": 1}, {"armer": "F", "seq": 5, "height": 199, "round": 1},
              {"armer": "G", "seq": 5, "height": 199, "round": 1}, {"armer": "H", "seq": 5, "height": 199, "round": 1},
              {"armer": "I", "seq": 5, "height": 199, "round": 1}],
     "manifest": [{"armer": "A", "seq": 5}, {"armer": "B", "seq": 5}],
     "valid": true},
    {"name": "round 1: an arm signed above the confiscation block",
     "round": 1, "opens": -1, "closes": 200,
     "arms": [{"armer": "A", "seq": 5, "height": 201, "round": 1}],
     "manifest": [{"armer": "A", "seq": 5}],
     "valid": false},
    {"name": "an arm the judge does not hold",
     "round": 1, "opens": -1, "closes": 200,
     "arms": [{"armer": "A", "seq": 5, "height": 190, "round": 1}],
     "manifest": [{"armer": "A", "seq": 6}],
     "valid": false},
    {"name": "an armer named twice",
     "round": 1, "opens": -1, "closes": 200,
     "arms": [{"armer": "A", "seq": 5, "height": 190, "round": 1}, {"armer": "A", "seq": 6, "height": 191, "round": 1}],
     "manifest": [{"armer": "A", "seq": 5}, {"armer": "A", "seq": 6}],
     "valid": false},
    {"name": "a fifth arm, past the four-arm bound",
     "round": 1, "opens": -1, "closes": 200,
     "arms": [{"armer": "A", "seq": 1, "height": 150, "round": 1}, {"armer": "A", "seq": 2, "height": 151, "round": 1},
              {"armer": "A", "seq": 3, "height": 152, "round": 1}, {"armer": "A", "seq": 4, "height": 153, "round": 1},
              {"armer": "A", "seq": 5, "height": 154, "round": 1}],
     "manifest": [{"armer": "A", "seq": 5}],
     "valid": false},
    {"name": "a re-arm round: the in-window arm, though a later backdated arm of the same round sits in the window too",
     "round": 2, "opens": 300, "closes": 306,
     "arms": [{"armer": "A", "seq": 10, "height": 302, "round": 2}, {"armer": "A", "seq": 11, "height": 306, "round": 2}],
     "manifest": [{"armer": "A", "seq": 10}],
     "valid": true},
    {"name": "a re-arm round: an arm of another round",
     "round": 2, "opens": 300, "closes": 306,
     "arms": [{"armer": "A", "seq": 10, "height": 303, "round": 3}],
     "manifest": [{"armer": "A", "seq": 10}],
     "valid": false},
    {"name": "a re-arm round: an arm before the window opens",
     "round": 2, "opens": 300, "closes": 306,
     "arms": [{"armer": "A", "seq": 10, "height": 300, "round": 2}],
     "manifest": [{"armer": "A", "seq": 10}],
     "valid": false},
    {"name": "an empty manifest",
     "round": 1, "opens": -1, "closes": 200,
     "arms": [{"armer": "A", "seq": 5, "height": 190, "round": 1}],
     "manifest": [],
     "valid": false}
  ]
}
